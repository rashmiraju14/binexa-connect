# Copy to .env.local, replace with values from your Supabase project, then restart npm run dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this public key instead of the publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put service-role keys or provider client secrets in NEXT_PUBLIC_ variables.
